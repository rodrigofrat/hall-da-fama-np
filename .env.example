# ===== Frontend (vai para o bundle público — somente valores publicáveis) =====
# demo = dados fictícios locais | supabase = produção
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Em produção no Pages o workflow define isto como /nome-do-repo/
VITE_BASE_PATH=/

# Vídeos da página inicial (YouTube, Vimeo, Google Drive ou /videos/arquivo.mp4). Vazio = "Vídeo em breve".
VITE_VIDEO_PAINEL_URL=
VITE_VIDEO_HALL_URL=

# ===== Sincronizador (NUNCA prefixar com VITE_; use GitHub Secrets) =====
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","...":"..."}
HALL_SPREADSHEET_ID=coloque-o-id-da-planilha-principal
# Opcional: planilha auxiliar privada com Calendário do portal, Resultados do portal e Previsões de presentes
PORTAL_AUX_SPREADSHEET_ID=
